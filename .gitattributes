# Единые переносы строк и пометка бинарных файлов
* text=auto

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.cs  text eol=crlf
*.md  text eol=lf
*.yml text eol=lf

*.png binary
*.zip binary
*.ico binary

# в архив git archive не попадает служебное и внутреннее
.github export-ignore
docs/review export-ignore
tests export-ignore
dist export-ignore
.gitignore export-ignore
.gitattributes export-ignore
PSScriptAnalyzerSettings.psd1 export-ignore
